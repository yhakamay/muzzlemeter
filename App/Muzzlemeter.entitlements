<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 計測時の気温・湿度・気圧を WeatherKit から取るために必要。
	     App ID (com.yhakamay.muzzlemeter) 側でも Capabilities と App Services の
	     両方で WeatherKit を有効にしてある。 -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<!-- ホーム画面ウィジェット（MuzzlemeterWidgets）と最新セッションのまとめを
	     共有するための App Group（Round E）。developer portal 側の App ID にも
	     同じグループを追加済み。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.yhakamay.muzzlemeter</string>
	</array>
</dict>
</plist>
