<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- アプリが書いた HomeWidgetSnapshot を読むための App Group（Round E）。
	     App/Muzzlemeter.entitlements と同じグループ。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.yhakamay.muzzlemeter</string>
	</array>
</dict>
</plist>
