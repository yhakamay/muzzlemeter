            "value": "槍枝設定檔"
          }
        }
      }
    },
    "鍵ハンドシェイク（0x4B）に応答がありません。本体の電源を入れ直すか、本体の電源ボタンを押してペアリングを許可してください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer to the key handshake (0x4B). Turn the chrono off and on again, or press its power button to allow pairing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵ハンドシェイク（0x4B）に応答がありません。本体の電源を入れ直すか、本体の電源ボタンを押してペアリングを許可してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰交握（0x4B）沒有回應。請將測速器關機再開機，或按下測速器的電源鍵以允許配對。"
          }
        }
      }
    },
    "閉じる": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "zh-Hant": {
