    "「もう一度」は同じ条件でもう %lld 発。「閉じる」は目標発数を解除します。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Go again” keeps the same setup for another %lld shots. “Close” clears the shot target."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「もう一度」は同じ条件でもう %lld 発。「閉じる」は目標発数を解除します。"
          }
        }
      }
    },
    "「ホップ強め」「新品」のような短い言葉を付けておくと、履歴で絞り込めます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short labels like \"More hop\" or \"Brand new\" let you filter the history later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ホップ強め」「新品」のような短い言葉を付けておくと、履歴で絞り込めます。"
          }
        }
      }
    },
