    "* 連射速度は本体からの報告が無いため、ショット間隔から推定した値です。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "* The chrono did not report a rate of fire, so this is estimated from the time between shots."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "* 連射速度は本体からの報告が無いため、ショット間隔から推定した値です。"
          }
        }
      }
    },
    "+SD": {
      "extractionState": "manual",
      "localizations": {
