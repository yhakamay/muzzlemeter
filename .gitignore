# macOS
.DS_Store

# Xcode
# .xcodeproj は project.yml から XcodeGen で生成する成果物なので追跡しない。
# 取得後は `xcodegen generate` を実行すること（README 参照）。
*.xcodeproj/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
xcuserdata/
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# プロトコル調査の作業用アーティファクト
# キャプチャログや中間生成物は巨大で、第三者の著作物を含みうるので
# リポジトリには入れない（tools/re/README.md 参照）。
tools/re/*.apk
tools/re/*.xapk
tools/re/jadx/
tools/re/xapk/
tools/re/libs/
tools/re/notes/
tools/re/captures/*.log

# 手順書と captures/ のプレースホルダだけは追跡する
tools/re/*
!tools/re/README.md
!tools/re/captures/
tools/re/captures/*
!tools/re/captures/.gitkeep
