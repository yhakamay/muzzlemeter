# macOS
.DS_Store

# Xcode
# .xcodeproj は project.yml から XcodeGen で生成する成果物なので追跡しない。
# 取得後は `xcodegen generate` を実行すること（README 参照）。
*.xcodeproj/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
xcuserdata/
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Reverse engineering artifacts
# APK / デコンパイル結果 / 文字列ダンプ / キャプチャログは
# 巨大かつ第三者の著作物なのでリポジトリには入れない。
tools/re/*.apk
tools/re/*.xapk
tools/re/jadx/
tools/re/xapk/
tools/re/libs/
tools/re/notes/
tools/re/captures/*.log

# 手順書と captures/ のプレースホルダだけは追跡する
tools/re/*
!tools/re/README.md
!tools/re/captures/
tools/re/captures/*
!tools/re/captures/.gitkeep
